# 复制为 application-local.properties 后填写本机配置。
# application-local.properties 已被 .gitignore 排除，禁止提交真实密码和微信密钥。
spring.datasource.password=请填写本机数据库密码

# 也可以在 IDEA 运行配置中使用 WECHAT_APP_ID 和 WECHAT_APP_SECRET 环境变量。
app.wechat.app-id=请填写微信小程序AppID
app.wechat.app-secret=请填写微信小程序AppSecret

spring.flyway.clean-disabled=true
logging.level.com.beifanghui.backend=DEBUG
