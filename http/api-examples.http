@userToken = mock_0bd77e6a0c6f41b3884737c788d90b1d
@adminToken = replace_with_admin_access_token
@opsToken = replace_with_ops_access_token
@orderId = 1

### Health
GET http://localhost:8080/api/v1/app/system/health

### Login as user
POST http://localhost:8080/api/v1/app/auth/mock-login
Content-Type: application/json

{
  "displayName": "模块开发人员",
  "accountType": "USER"
}

### Resources
GET http://localhost:8080/api/v1/app/resources?page=1&pageSize=20
Authorization: Bearer {{userToken}}

### Create order (replace skuId and use a new key for every new order)
POST http://localhost:8080/api/v1/app/orders
Authorization: Bearer {{userToken}}
Idempotency-Key: shared-order-001
Content-Type: application/json

{
  "items": [{"skuId": 5, "quantity": 1, "serviceDate": "2026-07-30", "timeSlot": ""}],
  "remark": "模块联调订单"
}

### Mock pay
POST http://localhost:8080/api/v1/app/orders/{{orderId}}/mock-pay
Authorization: Bearer {{userToken}}
Idempotency-Key: shared-payment-001

### Tickets
GET http://localhost:8080/api/v1/app/orders/{{orderId}}/tickets
Authorization: Bearer {{userToken}}

### Order payment/refund/verification timeline
GET http://localhost:8080/api/v1/app/orders/{{orderId}}/timeline
Authorization: Bearer {{userToken}}

### Admin order list
GET http://localhost:8080/api/v1/admin/orders?page=1&pageSize=20
Authorization: Bearer {{adminToken}}

### Admin order detail
GET http://localhost:8080/api/v1/admin/orders/{{orderId}}
Authorization: Bearer {{adminToken}}

### Admin scans overdue unpaid orders (also runs automatically every minute)
POST http://localhost:8080/api/v1/admin/orders/expire-overdue
Authorization: Bearer {{adminToken}}

### Admin takes a resource offline (restore ACTIVE after testing)
PATCH http://localhost:8080/api/v1/admin/resources/5/status
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{"status":"INACTIVE"}

### Admin adjusts inventory; replace inventoryId with a real bf_inventory.id
POST http://localhost:8080/api/v1/admin/inventories/5/adjust
Authorization: Bearer {{adminToken}}
Idempotency-Key: shared-inventory-adjust-001
Content-Type: application/json

{"delta":-1,"remark":"共享接口联调"}

### Ops audit log
GET http://localhost:8080/api/v1/ops/audit-logs?page=1&pageSize=20
Authorization: Bearer {{opsToken}}

### Mock refund (only for a paid and unused order)
POST http://localhost:8080/api/v1/app/orders/{{orderId}}/mock-refund
Authorization: Bearer {{userToken}}
Idempotency-Key: shared-refund-001
Content-Type: application/json

{"reason":"模块联调退款"}
